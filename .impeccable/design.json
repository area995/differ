      "css": ":host{--bg:#fff;--fg:#1d2330;--muted:#667085;--border:#d9dde5;--panel:#f7f8fa;--accent:#3b6fd8;--added:#e3f6e8;--added-bar:#2e9e50;--removed:#fde7e7;--removed-bar:#d0393e;--changed:#fff4cc;--changed-bar:#a87f00;--type:#ffe6d1;--type-bar:#c55a12;--moved:#e1ecff;--moved-bar:#3b6fd8;font-family:system-ui,-apple-system,\"Segoe UI\",sans-serif;color:var(--fg)} .ds-chips{display:flex;flex-wrap:wrap;gap:6px}.ds-chip{padding:2px 8px;border-left:4px solid;border-radius:4px;font-size:.85rem}.ds-added{background:var(--added);border-left-color:var(--added-bar)}.ds-removed{background:var(--removed);border-left-color:var(--removed-bar)}.ds-changed{background:var(--changed);border-left-color:var(--changed-bar)}.ds-type{background:var(--type);border-left-color:var(--type-bar)}.ds-moved{background:var(--moved);border-left-color:var(--moved-bar)}"
