      "css": ":host{--bg:#fff;--fg:#1d2330;--muted:#667085;--border:#d9dde5;--panel:#f7f8fa;--accent:#3b6fd8;--added:#e3f6e8;--added-bar:#2e9e50;--removed:#fde7e7;--removed-bar:#d0393e;--changed:#fff4cc;--changed-bar:#a87f00;--type:#ffe6d1;--type-bar:#c55a12;--moved:#e1ecff;--moved-bar:#3b6fd8;font-family:system-ui,-apple-system,\"Segoe UI\",sans-serif;color:var(--fg)} .ds-icon-btn{display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;padding:0;border:1px solid var(--border);border-radius:6px;background:var(--bg);color:var(--fg);cursor:pointer}.ds-icon-btn:hover{border-color:var(--accent);color:var(--accent)}.ds-icon-btn.ds-remove:hover{border-color:var(--removed-bar);color:var(--removed-bar)}.ds-icon-btn:focus-visible{outline:2px solid var(--accent);outline-offset:1px}"
    },
