      "name": "Small Button",
      "kind": "button",
      "refersTo": "button-small",
      "description": "Apply, matrix action and tree-tool button; quiet until hovered.",
      "html": "<button class=\"ds-btn-small\">A → B</button> <button class=\"ds-btn-small\" disabled>B → A</button>",
      "css": ":host{--bg:#fff;--fg:#1d2330;--muted:#667085;--border:#d9dde5;--panel:#f7f8fa;--accent:#3b6fd8;--added:#e3f6e8;--added-bar:#2e9e50;--removed:#fde7e7;--removed-bar:#d0393e;--changed:#fff4cc;--changed-bar:#a87f00;--type:#ffe6d1;--type-bar:#c55a12;--moved:#e1ecff;--moved-bar:#3b6fd8;font-family:system-ui,-apple-system,\"Segoe UI\",sans-serif;color:var(--fg)} .ds-btn-small{padding:2px 8px;border:1px solid var(--border);border-radius:4px;background:var(--bg);color:var(--fg);font:inherit;font-size:.85rem;white-space:nowrap;cursor:pointer}.ds-btn-small:hover:not(:disabled){border-color:var(--accent)}.ds-btn-small:focus-visible{outline:2px solid var(--accent);outline-offset:1px}.ds-btn-small:disabled{opacity:.4;cursor:not-allowed}"
    },
    {
      "name": "Icon Button",
      "kind": "button",
      "refersTo": "icon-button",
      "description": "28px square icon-only button with aria-label and tooltip; trash variant hovers red.",
